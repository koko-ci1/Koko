server {
    listen 443 ssl http2;
    server_name app.example.ci;

    # Configure valid TLS certificates on the real server.
    ssl_certificate /etc/letsencrypt/live/app.example.ci/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.ci/privkey.pem;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name app.example.ci;

    return 301 https://$host$request_uri;
}
